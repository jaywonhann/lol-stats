{
  "name": "livelol-desktop",
  "productName": "livelol.stats",
  "version": "1.0.0",
  "description": "Champ select build helper for League of Legends (livelol.stats)",
  "author": "livelol.stats",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "stats.livelol.desktop",
    "productName": "livelol.stats",
    "files": ["main.js", "lcu.js", "preload.js", "toolbar.html", "build/icon.png"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "livelol-setup.exe",
      "shortcutName": "livelol.stats",
      "createDesktopShortcut": true
    }
  }
}
